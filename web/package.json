{
  "name": "spearv-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "test:server-display": "node --experimental-transform-types --test src/features/mosaic/server-display-client.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
