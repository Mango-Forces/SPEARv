[Unit]
Description=SPEARv index-service (exposure index and bucket crawler)

[Service]
WorkingDirectory=%h/mango-spearv
Environment=SPEARV_INDEX_HOST=127.0.0.1 SPEARV_INDEX_PORT=8788
Environment=SPEARV_INDEX_DB=data/index.sqlite
Environment=SPEARV_INDEX_CRAWL_SECS=21600 SPEARV_INDEX_READS=256
Environment=SPEARV_CFITSIO_PREFIX=/home/ubuntu/mango-spearv/.build/native/cfitsio-4.7.0-prefix
ExecStart=%h/mango-spearv/spine/target/release/index-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
