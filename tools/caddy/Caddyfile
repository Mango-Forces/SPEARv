# SPEARv public site: mango.forces.quest/SPEARv via a Cloudflare Tunnel.
# Loopback only; Cloudflare terminates HTTPS and the tunnel connects out.
{
	auto_https off
}

:8090 {
	bind 127.0.0.1

	redir / /SPEARv/ 302
	redir /SPEARv /SPEARv/ 308

	handle_path /SPEARv/* {
		@engine path /api/* /embed /embed/*
		handle @engine {
			reverse_proxy 127.0.0.1:8787 {
				flush_interval -1
			}
		}
		handle {
			encode zstd gzip
			root * /var/www/spearv
			@hashed path /assets/* /fonts/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			header /index.html Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	handle {
		respond "Not found" 404
	}
}
